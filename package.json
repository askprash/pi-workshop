{
  "name": "pi-workshop-extension",
  "version": "0.1.0-beta",
  "description": "Public-beta Pi workshop extension for recursive expert ideation with safe defaults and audit artifacts.",
  "keywords": ["pi-package", "pi-extension", "workshop", "agents"],
  "license": "MIT",
  "author": "Prashanth Prakash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askprash/pi-workshop.git"
  },
  "bugs": {
    "url": "https://github.com/askprash/pi-workshop/issues"
  },
  "homepage": "https://github.com/askprash/pi-workshop#readme",
  "type": "module",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "config.ts",
    "artifacts.ts",
    "schemas.ts",
    "logic.js",
    "pi-workshop.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/static-tests.mjs",
    "smoke": "pi -e ./index.ts --mode json --no-session -p \"/workshop-config --check\" >/tmp/pi-workshop-smoke.jsonl",
    "validate": "npm test && npm run smoke"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
